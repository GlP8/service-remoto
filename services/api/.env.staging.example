# Copy these names into the staging provider's secret/environment settings.
# Do not commit a real .env.staging file or paste real secrets into GitHub issues.
NODE_ENV="staging"
PORT="3000"
DATABASE_URL="postgresql://STAGING_DB_USER:URL_ENCODED_PASSWORD@STAGING_DB_HOST:5432/service_remoto_staging?schema=public"
JWT_SECRET="GENERATE_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_BYTES"
JWT_ISSUER="service-remoto-api-staging"
JWT_AUDIENCE="service-remoto-client-staging"
CLIENT_ORIGIN="https://STAGING_CLIENT_HOST"
CLIENT_APP_URL="https://STAGING_CLIENT_HOST"
DIAGNOSTIC_CONSENT_VERSION="2026-09-24-v1"
RUSTDESK_EXECUTE="false"

# Add Stripe test-mode values only when staging checkout is being tested.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_CHECKOUT_MODE="subscription"
# STRIPE_MAINTENANCE_AMOUNT_CENTS="4999"
# STRIPE_PRICE_ID=""
