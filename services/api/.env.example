# Copy this file to `.env` and replace the placeholder with your real connection string.
NODE_ENV="development"
PORT="3000"

# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
JWT_SECRET="replace-with-a-generated-secret-of-at-least-32-bytes"
JWT_ISSUER="service-remoto-api"
JWT_AUDIENCE="service-remoto-client"
CLIENT_ORIGIN="http://localhost:5173"
CLIENT_APP_URL="http://localhost:5173"
DIAGNOSTIC_CONSENT_VERSION="2026-09-24-v1"
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_CHECKOUT_MODE="subscription"
STRIPE_MAINTENANCE_AMOUNT_CENTS="4999"
STRIPE_PRICE_ID=""
